{
  "name": "patch-text-editor",
  "version": "1.0.0",
  "description": "贴片文字背景修改工具 - 本地桌面版",
  "main": "electron/main.js",
  "author": "Local",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.local.patch-text-editor",
    "productName": "贴片文字修改工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "贴片文字修改工具.exe"
    },
    "portable": {
      "artifactName": "贴片文字修改工具.exe"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
